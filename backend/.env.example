# Home Media Backend Configuration
# Copy this file to .env and modify values as needed

# Server Configuration
PORT=8080
HOST=
ENVIRONMENT=development

# CORS Configuration (comma-separated list)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

JWT_SECRET=your-secret-key-change-in-production

# Rate limiting for write requests (POST/PUT/PATCH/DELETE, incl. login), per client IP.
# Defaults shown; uncomment to override. WRITE_RATE_LIMIT is sustained requests/second,
# WRITE_RATE_BURST is the burst allowance before throttling (HTTP 429) kicks in.
# WRITE_RATE_LIMIT=1.0
# WRITE_RATE_BURST=10

# Example for production:
# ENVIRONMENT=production
# PORT=8080
# HOST=0.0.0.0
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com